{
  "name": "school-mngmt-erp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:web": "npm run dev --workspace=web",
    "dev:mobile": "npm run start --workspace=mobile",
    "db:generate": "npm run generate --workspace=@school-erp/db",
    "db:migrate": "npm run migrate --workspace=@school-erp/db",
    "db:studio": "npm run studio --workspace=@school-erp/db"
  },
  "allowScripts": {
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true
  }
}
